# OpenAI / 兼容服务配置
OPENAI_API_KEY=sk-your-api-key-here
# OpenAI 兼容接口地址（留空则使用官方地址 https://api.openai.com/v1）
# 示例（DeepSeek）：OPENAI_BASE_URL=https://api.deepseek.com/v1
# 示例（通义千问）：OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 示例（本地 Ollama）：OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_BASE_URL=
# 模型名称（使用兼容服务时改为对应模型名，如 deepseek-chat、qwen-max 等）
OPENAI_MODEL=gpt-4o

# 安全配置
SECRET_KEY=your-jwt-secret-key-change-this

# 数据库
DATABASE_URL=sqlite:///./data/edubuddy.db

# 文件上传
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20

# 跨域
CORS_ORIGINS=http://localhost:5173,http://localhost:80
